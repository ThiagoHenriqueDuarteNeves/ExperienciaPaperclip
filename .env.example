# ============================================================
# Variáveis lidas pelo docker-compose
# Copie para .env e preencha os valores reais.
# ============================================================

# --- LLM Provider (chat/extração de entidades) ---
LLM_PROVIDER=deepseek
ANTHROPIC_API_KEY=sk-your-deepseek-key-here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- Embeddings (OpenAI text-embedding-3-large, 1536-dim) ---
# Deepseek NÃO tem API de embeddings. Use OpenAI ou outro provider compat.
# ATENÇÃO: trocar de provider requer recriar o schema:
#   docker compose down -v && docker compose up --build
MEMORY_EMBEDDING_API_BASE=https://api.openai.com/v1
MEMORY_EMBEDDING_API_KEY=sk-your-openai-key-here
MEMORY_EMBEDDING_API_MODEL=text-embedding-3-large

# --- Letta (MemGPT) ---
LETTA_API_KEY=letta-local-dev-key
