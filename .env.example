# ============================================================
# Variáveis lidas pelo docker-compose
# Copie para .env e preencha os valores reais.
# ============================================================

# --- LLM Provider (chat/extração de entidades) ---
# O memory-api fala o protocolo Anthropic Messages (POST /messages). O endpoint
# precisa ser compatível com esse protocolo (Anthropic, Deepseek-anthropic, ou
# um proxy de tradução como LiteLLM na frente de um LM Studio/Ollama).
LLM_PROVIDER=deepseek
ANTHROPIC_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Endpoint do LLM. Ordem de resolução no backend:
#   1. LLM_API_BASE  -> se preenchido, SEMPRE vence (qualquer provider).
#   2. default por provider:
#        deepseek  -> DEEPSEEK_API_BASE  (default https://api.deepseek.com/anthropic)
#        anthropic -> ANTHROPIC_API_BASE (default https://api.anthropic.com/v1)
# Deixe LLM_API_BASE vazio para usar o default do provider acima.
LLM_API_BASE=
DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-sonnet-4-20250506

# --- Embeddings (OpenAI text-embedding-3-large, 1536-dim) ---
# Deepseek NÃO tem API de embeddings. Use OpenAI ou outro provider compat.
# ATENÇÃO: trocar de provider requer recriar o schema:
#   docker compose down -v && docker compose up --build
MEMORY_EMBEDDING_API_BASE=https://api.openai.com/v1
MEMORY_EMBEDDING_API_KEY=sk-your-openai-key-here
MEMORY_EMBEDDING_API_MODEL=text-embedding-3-large

# --- Letta (MemGPT) ---
LETTA_API_KEY=letta-local-dev-key
