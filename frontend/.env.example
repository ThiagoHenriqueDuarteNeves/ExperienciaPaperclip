# ──────────────────────────────────────────────────────────────────────────
# Variáveis do frontend (Next.js)
#
# DEV LOCAL:  copie para `.env.local` e ajuste.
# PRODUÇÃO (Vercel): defina estas no painel do Vercel
#   (Project → Settings → Environment Variables → Production), NÃO em arquivo.
# ──────────────────────────────────────────────────────────────────────────

# URL da memory-api.
# - Dev local:  http://localhost:8001
# - Vercel:     o Vercel roda na nuvem e NÃO acessa seu localhost. Aponte para
#               uma URL PÚBLICA da sua API. Opções de túnel:
#                 zrok:        zrok share public http://localhost:8001
#                 cloudflared: cloudflared tunnel --url http://localhost:8001
#                 ngrok:       ngrok http 8001
#               Cole aqui a URL https resultante.
#   Obs.: para zrok, o frontend já envia o header `skip_zrok_interstitial`
#   automaticamente (ver src/lib/memory/client.ts) para pular a página de aviso.
MEMORY_API_URL=http://localhost:8001

# URL do endpoint de chat.
# - Dev local:  deixe em branco (usa /api/chat da rota Next.js).
# - Vercel:     aponte para o endpoint da memory-api exposta pelo zrok.
#               Deve terminar em /api/chat.
# NEXT_PUBLIC_ é baked no bundle do cliente em build time.
NEXT_PUBLIC_CHAT_API_URL=https://lmstudioapi.share.zrok.io/api/chat

# Provedor de LLM (chat + extração de entidades)
LLM_PROVIDER=deepseek

# Chave da API do LLM (Deepseek usa a mesma var; endpoint resolvido no código)
ANTHROPIC_API_KEY=sk-sua-chave-aqui

# (Opcional) base URL e modelo
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
CLAUDE_MODEL=claude-sonnet-4-20250506
